# Copie para .env.local e preencha. Nada aqui vai para o repositório com valores reais.

# Banco (Neon pela Vercel Marketplace em produção; Postgres local via docker compose em dev)
DATABASE_URL=postgres://pentagon:pentagon@localhost:5433/pentagon

# Auth.js: gere com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=
# OAuth App do GitHub (Settings > Developer settings > OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Emails que podem entrar, separados por vírgula
ALLOWED_EMAILS=

# Web Push (gere com `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do remetente dos avisos: URL do app ou mailto:
VAPID_SUBJECT=https://pentagon-mauve.vercel.app

# Upstash QStash (Vercel Marketplace)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Opcional: região do QStash (a integração da Vercel preenche quando precisa)
QSTASH_URL=
# Opcional: URL pública para o QStash chamar. Em produção na Vercel é descoberta sozinha;
# fora dela (ex.: túnel para testar avisos no dev), defina aqui.
APP_URL=

# Cron diário da Vercel (a Vercel envia como Bearer no header Authorization)
CRON_SECRET=

# Assistente de voz (API do Claude). Use uma chave de um workspace só do Pentagon, com limite de gasto.
# A chave fica só no servidor: nunca use o prefixo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
