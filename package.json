{
  "name": "pentagon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/migrar-no-build.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrar.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "icons": "node scripts/gerar-icones.mjs",
    "seed:trilha": "tsx scripts/seed-trilha.ts",
    "seed:rotina": "tsx scripts/seed-rotina.ts",
    "seed:seguranca": "tsx scripts/seed-seguranca.ts",
    "seed:roadmap": "tsx scripts/seed-roadmap.ts",
    "gerar:trilha-diaria": "node scripts/gerar-trilha-diaria.mjs",
    "test:integracao": "vitest run --config vitest.integracao.config.mts",
    "assistente:real": "tsx --conditions=react-server scripts/assistente-real.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@serwist/turbopack": "^9.5.13",
    "@upstash/qstash": "^2.12.0",
    "@vercel/functions": "^3.10.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.7.2",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
